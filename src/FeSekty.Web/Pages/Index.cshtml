@page
@model FeSekty.Web.Pages.IndexModel
@{
    Layout = null;
    var loginUrl = Url.Content("~/Account/Login");
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FeSekty – One route. One ride.</title>
    <meta name="description" content="FeSekty is a ride-hailing app for Egypt: book a seat on your route, share the ride and share the fare." />
    <meta name="theme-color" content="#15803d" />
    <link rel="icon" href="~/images/brand/favicon.ico" />
    <link rel="stylesheet" href="~/landing/landing.css" />
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
        <symbol id="i-route" viewBox="0 0 24 24"><circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 000-7h-11a3.5 3.5 0 010-7H15"/><circle cx="18" cy="5" r="3"/></symbol>
        <symbol id="i-users" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></symbol>
        <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></symbol>
        <symbol id="i-pin" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></symbol>
        <symbol id="i-card" viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2"/><path d="M1 10h22"/></symbol>
        <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></symbol>
        <symbol id="i-phone" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></symbol>
        <symbol id="i-support" viewBox="0 0 24 24"><path d="M3 18v-6a9 9 0 0118 0v6"/><path d="M21 19a2 2 0 01-2 2h-1v-6h3zM3 19a2 2 0 002 2h1v-6H3z"/></symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></symbol>
        <symbol id="i-seat" viewBox="0 0 24 24"><path d="M6 3h6a2 2 0 012 2v8H6z"/><path d="M4 13h14a2 2 0 012 2v2H4zM6 21v-4M18 21v-4"/></symbol>
    </defs>
</svg>

<header class="site-header" id="top">
    <div class="wrap header-row">
        <a class="brand" href="#top" aria-label="FeSekty">
            <img src="~/images/brand/wordmark-black.png" alt="FeSekty" width="150" height="28" />
        </a>
        <nav class="nav" id="nav" aria-label="Main">
            <a href="#how" data-i="nav.how">How it works</a>
            <a href="#features" data-i="nav.features">Features</a>
            <a href="#drivers" data-i="nav.drivers">Drive with us</a>
            <a href="#get-app" data-i="nav.app">Get the app</a>
        </nav>
        <div class="header-actions">
            <button class="lang" id="lang" type="button" aria-label="Switch language">العربية</button>
            <a class="btn btn-ghost" href="@loginUrl" data-i="nav.login">Log in</a>
            <button class="burger" id="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav"><span></span><span></span><span></span></button>
        </div>
    </div>
</header>

<main>
    <!-- HERO -->
    <section class="hero">
        <div class="wrap hero-grid">
            <div class="hero-copy">
                <p class="eyebrow" data-i="hero.eyebrow">Ride-hailing, made in Egypt</p>
                <h1><span data-i="hero.h1a">One route.</span> <span class="accent" data-i="hero.h1b">One ride.</span></h1>
                <p class="lead" data-i="hero.lead">Book a seat on your route, share the ride and share the fare. FeSekty is the simple, fair alternative to Uber and Careem.</p>
                <div class="cta-row">
                    <a class="btn btn-primary" href="#get-app" data-i="hero.cta1">Get the app</a>
                    <a class="btn btn-outline" href="#how" data-i="hero.cta2">See how it works</a>
                </div>
                <ul class="trust">
                    <li><svg class="ic"><use href="#i-check"/></svg><span data-i="trust.1">Fixed routes</span></li>
                    <li><svg class="ic"><use href="#i-check"/></svg><span data-i="trust.2">Shared fares</span></li>
                    <li><svg class="ic"><use href="#i-check"/></svg><span data-i="trust.3">Live tracking</span></li>
                </ul>
            </div>

            <div class="hero-visual" aria-hidden="true">
                <div class="blob"></div>
                <div class="phone">
                    <div class="phone-top"></div>
                    <div class="map">
                        <span class="pin pin-a"></span>
                        <span class="pin pin-b"></span>
                        <svg class="path" viewBox="0 0 200 120" preserveAspectRatio="none"><path d="M30 95 C 70 95, 60 30, 110 40 S 160 25, 172 22"/></svg>
                    </div>
                    <div class="ride-card">
                        <div class="ride-row"><span class="dot dot-a"></span><b>Maadi</b></div>
                        <div class="ride-row"><span class="dot dot-b"></span><b>Downtown</b></div>
                        <div class="ride-meta">
                            <span><svg class="ic"><use href="#i-seat"/></svg> 3 seats left</span>
                            <span><svg class="ic"><use href="#i-clock"/></svg> 08:15</span>
                        </div>
                        <div class="ride-btn">Book a seat</div>
                    </div>
                </div>
                <div class="float float-1"><svg class="ic"><use href="#i-shield"/></svg><span data-i="float.1">Verified drivers</span></div>
                <div class="float float-2"><svg class="ic"><use href="#i-users"/></svg><span data-i="float.2">Share &amp; save</span></div>
            </div>
        </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section" id="how">
        <div class="wrap">
            <h2 class="section-title" data-i="how.title">How FeSekty works</h2>
            <p class="section-sub" data-i="how.sub">Three taps from your door to your destination.</p>
            <ol class="steps">
                <li class="step">
                    <span class="step-num">1</span>
                    <svg class="ic ic-lg"><use href="#i-route"/></svg>
                    <h3 data-i="how.1t">Pick your route</h3>
                    <p data-i="how.1d">Choose where you are going and see the rides already heading your way.</p>
                </li>
                <li class="step">
                    <span class="step-num">2</span>
                    <svg class="ic ic-lg"><use href="#i-seat"/></svg>
                    <h3 data-i="how.2t">Book your seat</h3>
                    <p data-i="how.2d">Reserve one seat, see the fare upfront and know your pick-up time.</p>
                </li>
                <li class="step">
                    <span class="step-num">3</span>
                    <svg class="ic ic-lg"><use href="#i-pin"/></svg>
                    <h3 data-i="how.3t">Ride &amp; arrive</h3>
                    <p data-i="how.3d">Track your driver live, share your trip with family and arrive on time.</p>
                </li>
            </ol>
        </div>
    </section>

    <!-- FEATURES -->
    <section class="section section-alt" id="features">
        <div class="wrap">
            <h2 class="section-title" data-i="feat.title">Built for everyday rides</h2>
            <p class="section-sub" data-i="feat.sub">Everything you need for a better commute.</p>
            <div class="cards">
                <article class="card"><svg class="ic ic-lg"><use href="#i-route"/></svg><h3 data-i="feat.1t">Fixed routes</h3><p data-i="feat.1d">Predictable routes and pick-up points, so you always know where to be.</p></article>
                <article class="card"><svg class="ic ic-lg"><use href="#i-users"/></svg><h3 data-i="feat.2t">Share the fare</h3><p data-i="feat.2d">Riding together splits the cost, so every trip is easier on your wallet.</p></article>
                <article class="card"><svg class="ic ic-lg"><use href="#i-shield"/></svg><h3 data-i="feat.3t">Safety first</h3><p data-i="feat.3d">Verified drivers, trip sharing and in-app support on every ride.</p></article>
                <article class="card"><svg class="ic ic-lg"><use href="#i-pin"/></svg><h3 data-i="feat.4t">Live tracking</h3><p data-i="feat.4d">Watch your ride arrive in real time and get notified at pick-up.</p></article>
                <article class="card"><svg class="ic ic-lg"><use href="#i-card"/></svg><h3 data-i="feat.5t">Clear pricing</h3><p data-i="feat.5d">See your fare before you book. No surprises when you arrive.</p></article>
                <article class="card"><svg class="ic ic-lg"><use href="#i-support"/></svg><h3 data-i="feat.6t">Local support</h3><p data-i="feat.6d">A team that speaks your language, ready to help when you need it.</p></article>
            </div>
        </div>
    </section>

    <!-- DRIVERS -->
    <section class="drivers" id="drivers">
        <div class="wrap drivers-grid">
            <div>
                <p class="eyebrow eyebrow-light" data-i="drv.eyebrow">For drivers</p>
                <h2 data-i="drv.title">Drive with FeSekty</h2>
                <p class="lead lead-light" data-i="drv.lead">Fill your empty seats on the routes you already drive. Set your schedule, keep more of what you earn and get paid for every shared ride.</p>
                <ul class="checks">
                    <li><svg class="ic"><use href="#i-check"/></svg><span data-i="drv.1">Choose your own routes and hours</span></li>
                    <li><svg class="ic"><use href="#i-check"/></svg><span data-i="drv.2">More riders per trip</span></li>
                    <li><svg class="ic"><use href="#i-check"/></svg><span data-i="drv.3">Simple in-app earnings view</span></li>
                </ul>
                <a class="btn btn-light" href="#get-app" data-i="drv.cta">Become a driver</a>
            </div>
            <div class="drivers-art" aria-hidden="true"><img src="~/images/brand/logo-icon.png" alt="" width="220" height="220" /></div>
        </div>
    </section>

    <!-- GET THE APP -->
    <section class="section" id="get-app">
        <div class="wrap get-app">
            <h2 class="section-title" data-i="app.title">Take FeSekty with you</h2>
            <p class="section-sub" data-i="app.sub">The FeSekty app for Android and iOS is coming soon.</p>
            <div class="stores">
                <span class="store" aria-disabled="true"><svg class="ic"><use href="#i-phone"/></svg><span><small data-i="app.soon">Coming soon</small><b>Google Play</b></span></span>
                <span class="store" aria-disabled="true"><svg class="ic"><use href="#i-phone"/></svg><span><small data-i="app.soon2">Coming soon</small><b>App Store</b></span></span>
            </div>
        </div>
    </section>
</main>

<footer class="site-footer">
    <div class="wrap footer-row">
        <img src="~/images/brand/logo-white.png" alt="FeSekty – One route. One ride." width="170" height="42" />
        <nav class="footer-nav" aria-label="Footer">
            <a href="#how" data-i="nav.how">How it works</a>
            <a href="#features" data-i="nav.features">Features</a>
            <a href="#drivers" data-i="nav.drivers">Drive with us</a>
            <a href="@loginUrl" data-i="foot.admin">Team login</a>
        </nav>
        <p class="copy">&copy; 2026 FeSekty. <span data-i="foot.rights">All rights reserved.</span></p>
    </div>
</footer>

<script src="~/landing/landing.js"></script>
</body>
</html>
